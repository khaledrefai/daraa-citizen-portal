{
  "compilerOptions": {
    "jsx": "react",
    "target": "es6",
    "module": "es2020",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "baseUrl": "./",
    "paths": {
      "app/*": ["src/app/*"]
    },
    "lib": ["dom", "es2015", "es2016", "es2017", "es2019", "es2020"],
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/app"],
  "exclude": ["node_modules"]
}
